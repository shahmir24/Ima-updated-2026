# Copy this file to `.env` and fill in the two values below, then restart the
# dev server. `.env` is gitignored — never commit real values.
#
# Both come from your Supabase project: Settings > API.
#   VITE_SUPABASE_URL       "Project URL"
#   VITE_SUPABASE_ANON_KEY  "Project API keys" > anon / public
#
# The anon key is designed to be public and ships in the browser bundle; Row
# Level Security is what protects the data. Never put the service_role key here
# — it bypasses RLS and must stay server-side (Edge Functions only).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gentle nudges (optional). The Web Push VAPID PUBLIC key — the same value as
# the VAPID_PUBLIC_KEY Supabase secret. It is public by design. NEVER put the
# VAPID private key here: it stays in Supabase secrets only. Left empty, the
# app works as before and nudges simply report that they are unavailable.
VITE_VAPID_PUBLIC_KEY=

# NUDGE_SCHEDULER_SECRET does NOT belong in this file, and must never get a
# VITE_ prefix. It is a Supabase Edge Function secret only (Edge Functions >
# Secrets), used by Supabase Cron to call send-nudges. Generate a long random
# value (at least 32 characters, e.g. `openssl rand -base64 48`) and keep it in
# Supabase secrets and the cron job's x-nudge-scheduler-secret header only.
