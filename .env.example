# Copy this file to `.env` and fill in the two values below, then restart the
# dev server. `.env` is gitignored — never commit real values.
#
# Both come from your Supabase project: Settings > API.
#   VITE_SUPABASE_URL       "Project URL"
#   VITE_SUPABASE_ANON_KEY  "Project API keys" > anon / public
#
# The anon key is designed to be public and ships in the browser bundle; Row
# Level Security is what protects the data. Never put the service_role key here
# — it bypasses RLS and must stay server-side (Edge Functions only).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
